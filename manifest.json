{
  "manifest_version": 3,
  "name": "YouTube Preferences",
  "version": "1.0.1",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "description": "Disables unwanted YouTube playback features.",
  "permissions": ["storage"],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "YouTube Preferences",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-preferences@example.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": ["logic.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
