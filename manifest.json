{
  "manifest_version": 3,
  "name": "YouTube Preferences",
  "version": "1.0.0",
  "description": "Disables unwanted YouTube playback features.",
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-preferences@example.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": ["logic.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
